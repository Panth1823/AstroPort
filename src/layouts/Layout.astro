---
import "../styles/global.css";
import Dock from "../components/Dock.astro";
import LoadingScreen from "../components/LoadingScreen.tsx";
import SpeedInsights from "@vercel/speed-insights/astro";
import Analytics from "@vercel/analytics/astro";

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Panth",
  description = "Portfolio of Panth — building products people want to interact with.",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <!-- Theme script: must run inline before first paint to avoid flash -->
    <script is:inline src="/theme.js"></script>
    <!-- Loader gate: if already seen, mark body immediately so content is visible before React hydrates -->
    <script is:inline>
      try{if(localStorage.getItem("loading-screen-seen")==="true"){document.documentElement.dataset.loaderDone="1";document.addEventListener("DOMContentLoaded",function(){document.body.classList.add("loading-done")})}}catch(e){}
    </script>
  </head>
  <body>
    <LoadingScreen client:only="react" />
    <div class="mx-auto w-full max-w-160 px-6 pt-16 sm:pt-24">
      <slot />
    </div>
    <Dock />
    <SpeedInsights />
    <Analytics />

    <script>
      import { initGlobalSFX } from "../lib/sound";

      initGlobalSFX();
      document.addEventListener("astro:after-swap", initGlobalSFX);
    </script>
  </body>
</html>
