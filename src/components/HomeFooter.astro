---
// Server-rendered footer with small, progressive-enhancement behavior.
interface Props {
  email?: string;
  calUrl?: string;
}

const { email = "panthshah242@gmail.com", calUrl = "https://cal.com/panth18" } =
  Astro.props;
---

<footer
  class="relative mt-16 overflow-hidden rounded-2xl border border-white/10 bg-[#12100e]/90 p-8 sm:p-10 backdrop-blur-md"
>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 z-0 opacity-30 [background-image:radial-gradient(circle_at_80%_20%,rgba(255,56,0,.2),transparent_35%),linear-gradient(110deg,transparent_35%,rgba(255,255,255,.04),transparent_65%)]"
  >
  </div>

  <div class="relative z-10 flex flex-col gap-8">
    <div class="flex flex-col gap-2">
      <h3
        class="text-balance text-xl sm:text-2xl font-bold text-white tracking-tight"
      >
        Have a project in mind?
      </h3>

      <p class="max-w-lg text-sm sm:text-base text-[#a6a09b] leading-relaxed">
        I'm always open to discussing new opportunities, crazy ideas, or just
        chatting about tech over coffee.
      </p>
    </div>

    <!-- Action Buttons -->
    <div class="flex flex-wrap items-center gap-4">
      <!-- Book a Call Button -->
      <a
        href={calUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Book a call with Panth"
        class="group/book relative flex h-11 items-center overflow-hidden rounded-xl border border-white/15 bg-white/5 px-4 text-sm font-semibold text-white shadow-sm outline-none transition-all duration-200 hover:border-accent/50 hover:bg-accent/10 active:scale-[0.98]"
      >
        <span
          class="mr-2 flex h-6 w-6 items-center justify-center rounded-lg bg-accent/20 text-accent group-hover/book:bg-accent group-hover/book:text-white transition-colors"
        >
          <svg
            class="size-3.5 transition-transform duration-300 group-hover/book:rotate-90"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
        </span>
        <span>Book a call</span>
      </a>
    </div>

    <!-- Email Copy Section -->
    <div class="flex flex-wrap items-center text-sm text-[#a6a09b]">
      <span>email me at&nbsp;</span>
      <button
        type="button"
        id="copy-email-btn"
        data-email={email}
        aria-label={`Copy ${email}`}
        class="group/email inline-flex cursor-pointer items-center gap-1.5 rounded-md px-1.5 py-0.5 font-semibold text-white hover:text-accent transition-colors outline-none focus:ring-2 focus:ring-accent/40"
      >
        <span class="relative inline-flex size-4 items-center justify-center">
          <svg
            id="copy-icon-svg"
            class="size-4 text-accent transition-all duration-200"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"
            ></path>
          </svg>
          <svg
            id="check-icon-svg"
            class="absolute size-4 text-emerald-400 opacity-0 scale-50 transition-all duration-200"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </span>
        <span>{email}</span>
      </button>
    </div>
  </div>
</footer>

<script>
  // Copy Email Logic
  function initCopyEmail() {
    const copyBtn = document.getElementById("copy-email-btn");
    const copyIcon = document.getElementById("copy-icon-svg");
    const checkIcon = document.getElementById("check-icon-svg");

    if (!copyBtn) return;

    copyBtn.addEventListener("click", async () => {
      const email = copyBtn.getAttribute("data-email") || "";
      try {
        await navigator.clipboard.writeText(email);
        if (copyIcon && checkIcon) {
          copyIcon.classList.add("opacity-0", "scale-50");
          checkIcon.classList.remove("opacity-0", "scale-50");
          checkIcon.classList.add("opacity-100", "scale-100");

          setTimeout(() => {
            copyIcon.classList.remove("opacity-0", "scale-50");
            checkIcon.classList.add("opacity-0", "scale-50");
            checkIcon.classList.remove("opacity-100", "scale-100");
          }, 2000);
        }
      } catch (err) {
        console.error("Failed to copy email:", err);
      }
    });
  }

  function setup() {
    initCopyEmail();
  }

  setup();
  document.addEventListener("astro:after-swap", setup);
</script>
