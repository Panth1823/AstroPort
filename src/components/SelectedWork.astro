---
// SelectedWork – list-style project cards

interface Project {
  title: string;
  description: string;
  category: string;
  repo: string;
  stars: number;
  forks: number;
  website?: string | null;
  github: string;
}

const projects: Project[] = [
  {
    title: "formula1-mcp",
    description:
      "A Model Context Protocol (MCP) server providing real-time Formula 1 racing telemetry, driver stats, and lap data for AI models.",
    category: "mcp / ai",
    repo: "Panth1823/formula1-mcp",
    stars: 0,
    forks: 0,
    github: "https://github.com/Panth1823/formula1-mcp",
    website: "https://smithery.ai/servers/Panth1823/formula1-mcp",
  },
  {
    title: "FlashGenie",
    description:
      "AI-powered flashcard generator built with React and Google Gemini. Create and customize quiz content seamlessly for interactive learning.",
    category: "ai / web",
    repo: "Panth1823/FlashGenie",
    stars: 0,
    forks: 0,
    github: "https://github.com/Panth1823/FlashGenie",
    website: "https://flash-genie.vercel.app",
  },
  {
    title: "LearnTuber",
    description:
      "A web app that converts YouTube course videos into summarized notes as well as interactive quizzes.",
    category: "ai / web",
    repo: "NirbhaySirsikar/LearnTuber",
    stars: 12,
    forks: 6,
    github: "https://github.com/NirbhaySirsikar/LearnTuber",
    website: "https://learntuber.vercel.app",
  },
  {
    title: "sharesave",
    description:
      "A lightweight, fast file and snippet sharing utility for rapid, secure content exchange.",
    category: "developer tool",
    repo: "Panth1823/sharesave",
    stars: 0,
    forks: 0,
    github: "https://github.com/Panth1823/sharesave",
    website: "https://sharesave-six.vercel.app",
  },
];
---

<section id="selected-work">
  <p class="text-md font-medium text-primary text-[#a6a09b] mb-5">
    Selected work
  </p>

  <div class="flex flex-col divide-y divide-white/6 mb-16">
    {
      projects.map((project) => (
        <article class="group py-5 first:pt-0" data-repo={project.repo}>
          <div class="flex items-start justify-between gap-4">
            <div class="flex-1 min-w-0">
              <h3 class="text-lg font-semibold text-white leading-snug mb-1 group-hover:text-accent transition-colors duration-150 capitalize">
                {project.title}
              </h3>
              <p class="text-sm text-[#a6a09b] leading-[1.6] max-w-125">
                {project.description}
              </p>

              {/* Stars / Forks row */}
              {(project.stars !== undefined || project.forks !== undefined) && (
                <div class="flex items-center gap-4 mt-3">
                  {project.stars !== undefined && (
                    <span class="flex items-center gap-1 text-[13px] font-medium text-[#555] uppercase tracking-widest">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        class="text-[#444]"
                      >
                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                      </svg>
                      Stars&nbsp;
                      <span class="star-count text-white font-bold text-[16px]">
                        {project.stars}
                      </span>
                    </span>
                  )}
                  {project.forks !== undefined && (
                    <span class="flex items-center gap-1 text-[13px] font-medium text-[#555] uppercase tracking-widest">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="text-[#444]"
                      >
                        <line x1="6" y1="3" x2="6" y2="15" />
                        <circle cx="18" cy="6" r="3" />
                        <circle cx="6" cy="18" r="3" />
                        <path d="M18 9a9 9 0 0 1-9 9" />
                      </svg>
                      Forks&nbsp;
                      <span class="fork-count text-white font-bold text-[16px]">
                        {project.forks}
                      </span>
                    </span>
                  )}
                </div>
              )}
            </div>

            {/* Links */}
            <div class="flex items-center gap-3 shrink-0">
              {project.website && (
                <a
                  href={project.website}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-1 text-[0.75rem] text-[#666] hover:text-white transition-colors duration-150"
                  aria-label={`${project.title} website`}
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <circle cx="12" cy="12" r="10" />
                    <line x1="2" y1="12" x2="22" y2="12" />
                    <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
                  </svg>
                  Website
                </a>
              )}
              <a
                href={project.github}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-1 text-[0.75rem] text-[#666] hover:text-white transition-colors duration-150"
                aria-label={`${project.title} GitHub`}
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
                </svg>
                GitHub
              </a>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>

<script>
  async function fetchRepoStats() {
    try {
      const articles = document.querySelectorAll<HTMLElement>("[data-repo]");
      if (!articles.length) return;

      // Extract unique GitHub usernames from data-repo attributes
      const usernames = new Set<string>();
      articles.forEach((art) => {
        const repo = art.dataset.repo;
        if (repo && repo.includes("/")) {
          usernames.add(repo.split("/")[0]);
        }
      });

      const repoMap = new Map<string, { stars: number; forks: number }>();

      // Fetch user repos lists (200 OK) instead of individual repo endpoints (which 404 if private/unlisted)
      await Promise.all(
        Array.from(usernames).map(async (user) => {
          try {
            const res = await fetch(
              `https://api.github.com/users/${user}/repos?per_page=100`,
            );
            if (!res.ok) return;
            const repos = await res.json();
            if (Array.isArray(repos)) {
              repos.forEach((r: any) => {
                if (r.full_name) {
                  repoMap.set(r.full_name.toLowerCase(), {
                    stars: r.stargazers_count ?? 0,
                    forks: r.forks_count ?? 0,
                  });
                }
              });
            }
          } catch (err) {
            // Ignore fetch errors silently
          }
        }),
      );

      articles.forEach((article) => {
        const fullRepo = article.dataset.repo;
        if (!fullRepo) return;
        const data = repoMap.get(fullRepo.toLowerCase());
        if (data) {
          const starEl = article.querySelector<HTMLElement>(".star-count");
          const forkEl = article.querySelector<HTMLElement>(".fork-count");
          if (starEl && data.stars !== undefined)
            starEl.textContent = String(data.stars);
          if (forkEl && data.forks !== undefined)
            forkEl.textContent = String(data.forks);
        }
      });
    } catch (e) {
      // Ignore errors silently
    }
  }

  fetchRepoStats();
  document.addEventListener("astro:after-swap", fetchRepoStats);
</script>
