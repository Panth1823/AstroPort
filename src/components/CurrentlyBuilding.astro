---
// CurrentlyBuilding
---

<section id="currently-building">
  <p class="section-label mt-16 text-md text-[#a6a09b]">Currently building</p>

  <div class="flex items-center justify-between mt-5">
    <h2
      class="text-lg font-semibold tracking-tight capitalize text-foreground transition-colors group-hover:text-primary"
    >
      <a
        href="https://sharesave-six.vercel.app/"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-accent transition-colors text-lg"
      >
        sharesave
      </a>
    </h2>

    <div class="flex items-center gap-3 shrink-0">
      <a
        href="https://sharesave-six.vercel.app/"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-1 text-[0.75rem] text-[#666] hover:text-white transition-colors duration-150"
        aria-label="sharesave website"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="2" y1="12" x2="22" y2="12"></line>
          <path
            d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
          ></path>
        </svg>
        Website
      </a>
      <a
        href="https://github.com/Panth1823/sharesave"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-1 text-[0.75rem] text-[#666] hover:text-white transition-colors duration-150"
        aria-label="sharesave GitHub"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="currentColor"
        >
          <path
            d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"
          ></path>
        </svg>
        GitHub
      </a>
    </div>
  </div>

  <p class="text-sm text-[#a6a09b] leading-[1.65] mb-10">
    AI-ready "second brain" for saved content. Stop losing links in the void:
    capture intent, extract ideas, and actually revisit what you save
  </p>
</section>
