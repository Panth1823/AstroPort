---
// Dock — fixed bottom-right floating pill navigation
import ThemeToggle from "./ThemeToggle.astro";
const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname === "/" ? "/" : pathname.replace(/\/$/, "");

const baseBtn = "flex size-10 items-center justify-center rounded-full border border-transparent text-[#888] transition-all duration-200 ease-[cubic-bezier(0.16,1,0.3,1)]";
const activeBtn = "text-accent bg-[#ff3800]/15 border-[#ff3800]/35 shadow-[0_0_16px_rgba(255,56,0,0.25),inset_0_1px_1px_rgba(255,255,255,0.2)] hover:bg-[#ff3800]/25 hover:border-[#ff3800]/50";
const inactiveBtn = "hover:text-white hover:bg-white/12 hover:border-white/15 hover:shadow-[0_4px_12px_rgba(0,0,0,0.25)]";
---

<nav
  id="dock"
  aria-label="Quick navigation"
  class="fixed bottom-6 left-1/2 -translate-x-1/2 sm:left-auto sm:right-6 sm:translate-x-0 z-50 flex items-center gap-1.5 rounded-full border border-white/15 bg-card/70 px-1 py-1 backdrop-blur-xl backdrop-saturate-150 shadow-[0_10px_30px_rgba(0,0,0,0.5),inset_0_1px_1px_rgba(255,255,255,0.2)]"
>
  <!-- Home -->
  <a
    href="/"
    id="dock-home"
    aria-label="Home"
    data-uisfx-hover="hover"
    data-uisfx-press="press"
    class={`${baseBtn} ${currentPath === "/" ? activeBtn : inactiveBtn}`}
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
      <polyline points="9 22 9 12 15 12 15 22"></polyline>
    </svg>
  </a>

  <!-- About -->
  <a
    href="/about"
    id="dock-about"
    aria-label="About"
    data-uisfx-hover="hover"
    data-uisfx-press="press"
    class={`${baseBtn} ${currentPath === "/about" ? activeBtn : inactiveBtn}`}
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
      <circle cx="12" cy="7" r="4"></circle>
    </svg>
  </a>

  <!-- Work -->
  <a
    href="/work"
    id="dock-work"
    aria-label="Work"
    data-uisfx-hover="hover"
    data-uisfx-press="press"
    class={`${baseBtn} ${currentPath === "/work" ? activeBtn : inactiveBtn}`}
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
      <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
    </svg>
  </a>

  <!-- Contact -->
  <a
    href="mailto:panth@example.com"
    id="dock-contact"
    aria-label="Contact"
    data-uisfx-hover="hover"
    data-uisfx-press="press"
    class={`${baseBtn} ${inactiveBtn}`}
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path
        d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
      ></path>
      <polyline points="22,6 12,13 2,6"></polyline>
    </svg>
  </a>

  <!-- Divider -->
  <span class="w-px h-5 bg-white/10 mx-0.5" aria-hidden="true"></span>

  <!-- Theme Toggle -->
  <ThemeToggle />
</nav>

<script>
  import { playSFX } from "../lib/sound";

  function initDockSounds() {
    const items = document.querySelectorAll("#dock a, #dock button");
    items.forEach((item) => {
      item.addEventListener("click", () => {
        playSFX("press");
      });
    });
  }

  initDockSounds();
  document.addEventListener("astro:after-swap", initDockSounds);
</script>
