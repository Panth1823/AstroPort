---
// Spotlight — GitHub contributions heatmap component
interface Props {
  username?: string;
}

const { username = "Panth1823" } = Astro.props;
---

<section id="spotlight" class="my-10">
  <div class="mb-6 flex flex-col gap-1">
    <p class="text-lg font-semibold text-primary mb-1">Github Heatmap</p>
    <div class="flex items-center justify-between text-sm sm:text-sm">
      <p class="text-[#888]">
        Total: <span id="total-contributions" class="font-bold text-white"
          >--</span
        > contributions
      </p>
      <p class="text-xs sm:text-sm text-[#888]">Currently touching grass</p>
    </div>
  </div>

  <div
    class="relative w-full overflow-hidden rounded-xl border border-white/10 bg-[#12100e]/80 p-4 backdrop-blur-sm"
  >
    <!-- Graph Container -->
    <div
      id="github-graph-container"
      class="flex overflow-x-auto gap-1 scrollbar-none select-none"
    >
      <!-- Loading skeleton grid -->
      <div class="flex gap-1 animate-pulse" id="graph-skeleton">
        {
          Array.from({ length: 50 }).map(() => (
            <div class="flex flex-col gap-1">
              {Array.from({ length: 7 }).map(() => (
                <div class="size-2.5 rounded-xs bg-white/5" />
              ))}
            </div>
          ))
        }
      </div>
    </div>

    <!-- Accessibility Slider & Legend -->
    <div
      class="mt-4 flex flex-col sm:flex-row items-center justify-between gap-3 pt-2 border-t border-white/5"
    >
      <div class="w-full sm:w-2/3 flex items-center">
        <label for="heatmap-slider" class="sr-only"
          >Scroll GitHub heatmap timeline slider</label
        >
        <input
          type="range"
          id="heatmap-slider"
          min="0"
          max="100"
          value="100"
          aria-label="Scroll GitHub heatmap timeline"
          aria-controls="github-graph-container"
          class="heatmap-slider-input w-full h-1 bg-white/15 rounded-lg appearance-none cursor-pointer"
        />
      </div>

      <div
        class="flex items-center gap-1.5 text-[10px] tracking-wider text-[#888] uppercase select-none font-mono self-end sm:self-center"
      >
        <span>LESS</span>
        <span class="size-2.5 rounded-xs bg-[#1c1917] border border-white/5"
        ></span>
        <span class="size-2.5 rounded-xs bg-accent/30"></span>
        <span class="size-2.5 rounded-xs bg-accent/60"></span>
        <span class="size-2.5 rounded-xs bg-accent"></span>
        <span class="size-2.5 rounded-xs bg-[#ffa080]"></span>
        <span>MORE</span>
      </div>
    </div>

    <!-- Tooltip -->
    <div
      id="graph-tooltip"
      class="pointer-events-none fixed z-50 hidden rounded-md bg-[#1a1714] border border-accent/40 px-2.5 py-1 text-xs text-white shadow-[0_4px_20px_rgba(255,56,0,0.25)] -translate-x-1/2 -translate-y-full mb-2 whitespace-nowrap"
    >
    </div>
  </div>
</section>

<style>
  .heatmap-slider-input::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #ff3800;
    cursor: pointer;
    box-shadow: 0 0 8px rgba(255, 56, 0, 0.6);
    transition: transform 0.15s ease;
  }
  .heatmap-slider-input::-webkit-slider-thumb:hover {
    transform: scale(1.25);
  }
  .heatmap-slider-input::-moz-range-thumb {
    width: 14px;
    height: 14px;
    border: none;
    border-radius: 50%;
    background: #ff3800;
    cursor: pointer;
    box-shadow: 0 0 8px rgba(255, 56, 0, 0.6);
    transition: transform 0.15s ease;
  }
  .heatmap-slider-input::-moz-range-thumb:hover {
    transform: scale(1.25);
  }
</style>

<script define:vars={{ username }}>
  async function fetchContributions() {
    const container = document.getElementById("github-graph-container");
    const tooltip = document.getElementById("graph-tooltip");
    const slider = document.getElementById("heatmap-slider");
    const totalEl = document.getElementById("total-contributions");

    if (!container) return;

    let isDragging = false;

    function syncSlider() {
      if (!container || !slider || isDragging) return;
      const maxScroll = container.scrollWidth - container.clientWidth;
      if (maxScroll > 0) {
        const val = (container.scrollLeft / maxScroll) * 100;
        slider.value = val;
        slider.setAttribute("aria-valuenow", Math.round(val));
      }
    }

    if (slider && container) {
      const updateScrollFromSlider = () => {
        const maxScroll = container.scrollWidth - container.clientWidth;
        container.scrollLeft = (parseFloat(slider.value) / 100) * maxScroll;
      };

      slider.addEventListener("pointerdown", () => {
        isDragging = true;
      });

      window.addEventListener("pointerup", () => {
        if (isDragging) {
          isDragging = false;
          syncSlider();
        }
      });

      slider.addEventListener("input", updateScrollFromSlider);
      container.addEventListener("scroll", syncSlider, { passive: true });
    }

    let contributions = [];
    let totalCount = 0;

    // Use the API that supports browser CORS. Load this section only when visible.
    try {
      const res = await fetch(
        `https://github-contributions-api.jogruber.de/v4/${username}?y=last`,
        { signal: AbortSignal.timeout(6000) }
      );
      if (!res.ok) throw new Error(`GitHub contributions API returned status ${res.status}`);
      const data = await res.json();
      contributions = data.contributions || [];
      totalCount =
        data.total?.lastYear ??
        contributions.reduce((acc, c) => acc + (c.count || 0), 0);
    } catch (err1) {
      console.warn("GitHub contributions unavailable, using fallback grid:", err1);
    }

    // Fallback if both APIs failed (e.g. offline)
    if (!contributions || contributions.length === 0) {
      contributions = [];
      const today = new Date();
      const start = new Date(today);
      start.setDate(today.getDate() - 364);
      start.setDate(start.getDate() - start.getDay());

      for (let i = 0; i < 371; i++) {
        const d = new Date(start);
        d.setDate(start.getDate() + i);
        const dStr = d.toISOString().split("T")[0];
        // Generate pseudo-random realistic values
        const isPast = d <= today;
        const seed = Math.sin(i * 12.9898) * 43758.5453;
        const pseudoRand = seed - Math.floor(seed);
        const count = isPast ? (pseudoRand > 0.65 ? Math.floor(pseudoRand * 12) : 0) : 0;
        contributions.push({ date: dStr, count });
        if (isPast) totalCount += count;
      }
    }

    if (totalEl) {
      totalEl.textContent = totalCount.toLocaleString();
    }

    // Group into weeks (7 days each)
    const weeks = [];
    for (let i = 0; i < contributions.length; i += 7) {
      weeks.push(contributions.slice(i, i + 7));
    }

    // Build HTML
    container.innerHTML = "";
    const weeksWrapper = document.createElement("div");
    weeksWrapper.className = "flex gap-1 min-w-max";

    weeks.forEach((week) => {
      const weekCol = document.createElement("div");
      weekCol.className = "flex flex-col gap-1";

      week.forEach((day) => {
        const square = document.createElement("div");
        const count = day.count || 0;

        // Orange accent color scale
        let colorClass = "bg-[#1c1917]";
        if (count > 0 && count < 3) colorClass = "bg-accent/30";
        else if (count >= 3 && count < 6) colorClass = "bg-accent/60";
        else if (count >= 6 && count < 10) colorClass = "bg-accent";
        else if (count >= 10)
          colorClass = "bg-[#ffa080] shadow-[0_0_8px_rgba(255,56,0,0.8)]";

        square.className = `size-2.5 rounded-xs ${colorClass} transition-all duration-150 hover:scale-125 hover:z-10 cursor-pointer`;
        square.dataset.date = day.date;
        square.dataset.count = count;

        // Tooltip listeners
        square.addEventListener("mouseenter", (e) => {
          if (!tooltip) return;
          const [y, m, d] = day.date.split("-");
          const dateObj = new Date(parseInt(y), parseInt(m) - 1, parseInt(d));
          const formattedDate = dateObj.toLocaleDateString("en-US", {
            month: "short",
            day: "numeric",
            year: "numeric",
          });
          const text =
            count === 0
              ? `No contributions on ${formattedDate}`
              : `${count} contribution${count > 1 ? "s" : ""} on ${formattedDate}`;
          tooltip.textContent = text;
          tooltip.classList.remove("hidden");

          const rect = square.getBoundingClientRect();
          tooltip.style.left = `${rect.left + rect.width / 2}px`;
          tooltip.style.top = `${rect.top - 6}px`;
        });

        square.addEventListener("mouseleave", () => {
          tooltip?.classList.add("hidden");
        });

        weekCol.appendChild(square);
      });

      weeksWrapper.appendChild(weekCol);
    });

    container.appendChild(weeksWrapper);

    // Auto-scroll to current date on right
    requestAnimationFrame(() => {
      container.scrollLeft = container.scrollWidth;
      syncSlider();
    });
  }

  const spotlight = document.getElementById("spotlight");
  if (spotlight && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        observer.disconnect();
        fetchContributions();
      },
      { rootMargin: "400px" },
    );
    observer.observe(spotlight);
  } else {
    fetchContributions();
  }
</script>
