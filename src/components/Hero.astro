    <a
      href="mailto:panth@example.com"
      data-cuelume-hover="tick"
      class="flex items-center justify-center w-9 h-9 rounded-md text-[#999] transition-colors duration-150 hover:text-accent"
      aria-label="Email"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
