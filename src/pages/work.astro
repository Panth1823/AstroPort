---
import Layout from "../layouts/Layout.astro";

const caseStudies = [
  {
    title: "sharesave",
    description:
      "AI-ready \"second brain\" for saved content. Stop losing links in the void: capture intent, extract ideas, and actually revisit what you save.",
    date: "In progress",
    href: "https://sharesave-six.vercel.app/",
    links: [{ label: "Website", href: "https://sharesave-six.vercel.app/" }],
  },
  {
    title: "Formula1 MCP Server",
    description:
      "A Model Context Protocol (MCP) server providing real-time Formula 1 telemetry, driver stats, and lap analysis for AI models via FastF1 and OpenF1 APIs.",
    date: "2025",
    href: "https://github.com/Panth1823/formula1-mcp",
    links: [{ label: "GitHub", href: "https://github.com/Panth1823/formula1-mcp" }],
  },
  {
    title: "AstroPort",
    description:
      "A sleek, typography-driven developer portfolio template built with Astro, Tailwind CSS, Space Grotesk typography, and tactile UI sound effects.",
    date: "2025",
    href: "https://panthshah.vercel.app",
    links: [{ label: "Website", href: "https://panthshah.vercel.app" }],
  },
  {
    title: "FlashGenie",
    description:
      "AI-powered flashcard generator built with React and Google Gemini. Generates interactive quiz content from text and uploaded images with sub-second response times.",
    date: "2024",
    href: "https://flash-genie.vercel.app",
    links: [{ label: "Website", href: "https://flash-genie.vercel.app" }],
  },
  {
    title: "LearnTuber",
    description:
      "An AI summarization platform that converts YouTube course videos into concise structured notes and interactive quizzes. Winner of Skillathon 1.0.",
    date: "2024",
    href: "https://learntuber.vercel.app",
    links: [{ label: "Website", href: "https://learntuber.vercel.app" }],
  },
  {
    title: "Cartopia",
    description:
      "Full-stack e-commerce web application engineered with React frontend, Strapi CMS backend, PostgreSQL database, and Cloudinary media management.",
    date: "2024",
    href: "https://github.com/Panth1823/Cartopia",
    links: [{ label: "GitHub", href: "https://github.com/Panth1823/Cartopia" }],
  },
];

const tools = [
  {
    title: "Formula1 MCP Server ↗",
    description:
      "Context provider allowing Claude and other AI models to query real-time F1 race pace, telemetry comparisons, and standings.",
    tags: ["mcp", "typescript", "ai", "f1"],
    href: "https://github.com/Panth1823/formula1-mcp",
  },
  {
    title: "AstroPort Template ↗",
    description:
      "Open-source developer portfolio built for speed, clean aesthetics, theme switching, and minimal audio micro-interactions.",
    tags: ["astro", "tailwind", "typescript", "template"],
    href: "https://github.com/Panth1823/AstroPort",
  },
  {
    title: "FlashGenie AI Engine ↗",
    description:
      "Multi-modal prompt engineering and flashcard extraction utility powered by Gemini 1.5 and Cloudflare Workers.",
    tags: ["react", "gemini", "ai", "edtech"],
    href: "https://github.com/Panth1823/FlashGenie",
  },
];
---

<Layout
  title="Work - Panth"
  description="Case studies and open-source tools built by Panth Shah."
>
  <div class="pb-28">
    <!-- Breadcrumb -->
    <nav
      class="flex items-center gap-2 text-[0.72rem] font-medium tracking-widest uppercase mb-14"
    >
      <a
        href="/"
        class="inline-flex items-center gap-1.5 text-[#a6a09b] hover:text-accent transition-colors duration-150 text-[12px]"
        data-uisfx-hover="hover"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="1em"
          height="1em"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-3.5"
          aria-hidden="true"
        >
          <path d="M20 12H4m0 0l6-6m-6 6l6 6"></path>
        </svg>
        Back to home
      </a>
      <span class="text-[#333]">/</span>
      <span class="text-accent text-[12px]">Work</span>
    </nav>

    <!-- Page heading -->
    <div class="mb-12">
      <h1 class="text-3xl font-bold leading-[1.08] tracking-tight sm:text-4xl">
        Work
      </h1>
      <p class="mt-4 max-w-136 leading-relaxed text-[#a6a09b] text-md">
        Projects I've shipped, plus the open-source tools I build on the side.
      </p>
    </div>

    <!-- Case Studies -->
    <section class="mb-14">
      <p class="font-medium mb-6 section-label mt-16 text-md text-[#a6a09b]">
        Case studies
      </p>

      <div class="flex flex-col divide-y divide-white/6">
        {
          caseStudies.map((project) => (
            <a
              href={project.href}
              target="_blank"
              rel="noopener noreferrer"
              data-uisfx-hover="hover"
              class="group flex items-start justify-between gap-6 py-4 hover:opacity-80 transition-opacity duration-150"
            >
              <div class="flex-1 min-w-0">
                <h2 class="text-md font-semibold text-white leading-snug mb-1 group-hover:text-accent transition-colors duration-150">
                  {project.title}
                </h2>
                <p class="text-sm text-[#a6a09b] leading-[1.6]">
                  {project.description}
                </p>
              </div>
              <span class="shrink-0 text-[13px] text-[#a6a09b]">
                {project.date}
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <!-- Tools -->
    <section>
      <p class="font-medium mb-6 section-label mt-16 text-md text-[#a6a09b]">
        Tools & Open Source
      </p>

      <div class="flex flex-col divide-y divide-white/6">
        {
          tools.map((tool) => (
            <div class="py-4">
              <div class="flex items-start gap-1.5 mb-1.5">
                <h2 class="text-[0.95rem] font-semibold text-white leading-snug mb-0">
                  <a
                    href={tool.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-uisfx-hover="hover"
                    class="hover:text-accent transition-colors duration-150 inline-flex items-center gap-1"
                  >
                    {tool.title}
                  </a>
                </h2>
              </div>
              <p class="text-sm text-[#a6a09b] leading-[1.6] mb-2.5">
                {tool.description}
              </p>
              <div class="flex flex-wrap gap-1.5">
                {tool.tags.map((tag) => (
                  <span class="px-2 py-0.5 rounded-full text-[0.68rem] font-medium bg-[#292526] border border-white/[0.07] text-[#a6a09b]">
                    #{tag}
                  </span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </section>
  </div>
</Layout>
