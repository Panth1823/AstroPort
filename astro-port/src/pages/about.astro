---
import Layout from "../layouts/Layout.astro";

const experience = [
  {
    company: "Parul University",
    location: "Vadodara, Gujarat",
    roles: [
      {
        title: "Technical Lead — Skillathon",
        type: "Contract",
        period: "2024 - Now",
        active: true,
      },
      {
        title: "Full-Stack Developer — PLH",
        type: "Full-time",
        period: "2023 - 24",
        active: false,
      },
    ],
  },
  {
    company: "Google Developer Groups",
    location: "India (Remote)",
    roles: [
      {
        title: "Core Team — GenAI Exchange",
        type: "Volunteer",
        period: "2024",
        active: false,
      },
    ],
  },
  {
    company: "Independent",
    location: "@panth1823",
    roles: [
      {
        title: "Open Source Builder",
        type: "Self-driven",
        period: "2022 - Now",
        active: false,
      },
    ],
  },
];

const education = [
  {
    period: "2022 - 26",
    degree: "B.Tech in Computer Science & Engineering",
    institution: "Parul University",
  },
];
---

<Layout
  title="About — Panth"
  description="About Panth — CS student, developer, and builder of AI-powered full-stack applications."
>
  <div class="pb-20">

    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-[0.72rem] font-medium tracking-widest uppercase mb-10">
      <a href="/" class="text-[#555] hover:text-accent transition-colors duration-150">
        &larr; Back to home
      </a>
      <span class="text-[#333]">/</span>
      <span class="text-accent">About</span>
    </nav>

    <!-- Profile -->
    <div class="flex items-center gap-4 mb-8">
      <img
        src="/me.jpg"
        alt="Panth Patel"
        class="w-14 h-14 rounded-full object-cover ring-1 ring-white/10 shrink-0"
      />
      <div>
        <h1 class="text-[1.1rem] font-semibold text-white leading-snug">Panth Patel</h1>
        <p class="text-[0.82rem] text-[#666] mt-0.5">
          CS Student &amp; Developer at
          <a
            href="https://paruluniversity.ac.in"
            target="_blank"
            rel="noopener noreferrer"
            class="text-white hover:text-accent transition-colors"
          >
            Parul University.
          </a>
        </p>
      </div>
    </div>

    <!-- Bio -->
    <div class="space-y-4 text-[0.88rem] leading-[1.75] text-[#888] mb-8">
      <p>
        I'm <span class="text-accent font-medium">Panth</span>, a Computer Science
        student and developer based in India. I build
        <span class="text-white">AI-powered products</span> and full-stack applications
        that solve real problems — from hackathon platforms to F1 telemetry tools.
      </p>
      <p>
        Right now I'm working on
        <a
          href="https://github.com/Panth1823"
          target="_blank"
          rel="noopener noreferrer"
          class="text-accent hover:underline underline-offset-2"
        >formulaCoach</a
        > — an AI-powered F1 analysis platform. I like digging into the technical
        details, but the goal is always to keep things
        <span class="text-white">fast, focused, and useful</span>.
      </p>
    </div>

    <!-- Social Links -->
    <div class="flex items-center gap-2 mb-14">
      <a
        href="https://instagram.com"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Instagram"
        class="social-pill"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
          <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
        </svg>
      </a>
      <a
        href="https://github.com/Panth1823"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
        class="social-pill"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
        </svg>
      </a>
      <a
        href="https://linkedin.com/in/panthpatel18"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn"
        class="social-pill"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
          <rect x="2" y="9" width="4" height="12"></rect>
          <circle cx="4" cy="4" r="2"></circle>
        </svg>
      </a>
      <a
        href="mailto:panthpatel18@example.com"
        aria-label="Email"
        class="social-pill"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
          <polyline points="22,6 12,13 2,6"></polyline>
        </svg>
      </a>
    </div>

    <!-- Experience -->
    <section class="mb-12">
      <h2 class="text-[0.72rem] font-medium tracking-widest uppercase text-[#555] mb-6">
        Experience
      </h2>

      <div class="space-y-8">
        {
          experience.map((job) => (
            <div class="flex gap-4">
              <!-- Company icon bubble -->
              <div class="mt-0.5 shrink-0 w-8 h-8 rounded-md border border-white/10 bg-surface flex items-center justify-center text-[#555]">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                  <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                </svg>
              </div>

              <div class="flex-1 min-w-0">
                <!-- Company -->
                <div class="flex items-center gap-2 mb-1">
                  <span class="text-[0.88rem] font-semibold text-white">{job.company}</span>
                </div>
                <p class="text-[0.75rem] text-[#555] mb-3">{job.location}</p>

                <!-- Roles -->
                <div class="space-y-2">
                  {job.roles.map((role) => (
                    <div class="flex items-center justify-between gap-4 py-1.5 border-l border-white/[0.07] pl-3">
                      <div class="flex items-center gap-2 min-w-0">
                        <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={role.active ? "text-accent" : "text-[#444]"}>
                          <circle cx="12" cy="12" r="10" />
                        </svg>
                        <span class={`text-[0.82rem] font-medium ${role.active ? "text-accent" : "text-[#bbb]"}`}>
                          {role.title}
                        </span>
                      </div>
                      <span class="text-[0.72rem] text-[#444] shrink-0">
                        {role.type} · {role.period}
                      </span>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Education -->
    <section>
      <h2 class="text-[0.72rem] font-medium tracking-widest uppercase text-[#555] mb-5">
        Education
      </h2>

      <div class="space-y-3">
        {
          education.map((edu) => (
            <div class="flex items-baseline gap-5">
              <span class="text-[0.75rem] text-[#444] shrink-0 w-16 text-right">{edu.period}</span>
              <div>
                <span class="text-[0.85rem] font-medium text-white">{edu.degree}</span>
                <span class="text-[#555]">, </span>
                <span class="text-[0.85rem] text-[#666]">{edu.institution}</span>
              </div>
            </div>
          ))
        }
      </div>
    </section>

  </div>
</Layout>

<style>
  .social-pill {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.375rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #666;
    transition: color 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
  }

  .social-pill:hover {
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.18);
    background-color: rgba(255, 255, 255, 0.05);
  }
</style>
