---
import Layout from "../layouts/Layout.astro";

const experience = [
  {
    company: "Parul University",
    location: "Vadodara, Gujarat",
    roles: [
      {
        title: "Technical Lead — Skillathon",
        type: "Contract",
        period: "2024 - Now",
        active: true,
        icon: "briefcase",
        description: "Leading full-stack development of Skillathon, an NSDC-backed skilling & hackathon platform with real-time leaderboards, OBC support, and team management.",
      },
      {
        title: "Full-Stack Developer — PLH",
        type: "Full-time",
        period: "2023 - 24",
        active: false,
        icon: "code",
        description: "Built PLH (Parul Let's Hack), a hackathon management platform handling registrations, team formation, judging, and live result broadcasting for 2000+ participants.",
      },
    ],
  },
  {
    company: "Google Developer Groups",
    location: "India (Remote)",
    roles: [
      {
        title: "Core Team — GenAI Exchange",
        type: "Volunteer",
        period: "2024",
        active: false,
        icon: "users",
        description: "Helped organize and run the GenAI Exchange hackathon connecting developers, mentors, and sponsors across India, powered by Google's Generative AI stack.",
      },
    ],
  },
  {
    company: "Independent",
    location: "@panth1823",
    roles: [
      {
        title: "Open Source Builder",
        type: "Self-driven",
        period: "2022 - Now",
        active: false,
        icon: "git",
        description: "Building and contributing to open-source projects — from F1 telemetry tools (formulaCoach) to developer utilities and AI experiments.",
      },
    ],
  },
];

const education = [
  {
    period: "2022 - 26",
    degree: "B.Tech in Computer Science & Engineering",
    institution: "Parul University",
  },
];
---

<Layout
  title="About — Panth"
  description="About Panth — CS student, developer, and builder of AI-powered full-stack applications."
>
  <div class="pb-20">

    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-[0.72rem] font-medium tracking-widest uppercase mb-14">
      <a href="/" class="inline-flex items-center gap-1.5 text-[#a6a09b] hover:text-accent transition-colors duration-150 text-[12px]">
        <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="size-3.5" aria-hidden="true">
          <path d="M20 12H4m0 0l6-6m-6 6l6 6"></path>
        </svg>
        Back to home
      </a>
      <span class="text-[#333]">/</span>
      <span class="text-accent text-[12px]">About</span>
    </nav>

    <!-- Profile -->
    <div class="flex items-center gap-4 mb-10">
      <img
        src="/me.jpg"
        alt="Panth Patel"
        class="size-14 shrink-0 rounded-xl object-cover object-center"
      />
      <div>
        <h1 class="text-2xl font-bold tracking-tight">Panth</h1>
        <p class="mt-0.5 text-[14px] text-muted-foreground">
          Fullstack Developer at {" "}
          <a
            href="https://paruluniversity.ac.in"
            target="_blank"
            rel="noopener noreferrer"
            class="text-white hover:text-accent transition-colors underline underline-offset-4"
          >
            Koiostudio
          </a>
        </p>
      </div>
    </div>

    <!-- Bio -->
    <div class="space-y-4 text-[0.88rem] leading-[1.75] text-[#888] mb-6 flex flex-col">
      <p class="mb-5 text-[15px] text-white">
        I'm Panth, a Computer Science
        student and developer based in India. I build
        <span class="text-white">AI-powered products</span> and full-stack applications
        that solve real problems — from hackathon platforms to F1 telemetry tools.
      </p>
      <p class="mb-0 text-[15px] text-white">
        Right now I'm working on
        <a
          href="https://github.com/Panth1823"
          target="_blank"
          rel="noopener noreferrer"
          class="text-accent hover:underline underline-offset-2"
        > formulaCoach</a
        > an AI-powered F1 analysis platform. I like digging into the technical
        details, but the goal is always to keep things
        <span class="text-white">fast, focused, and useful</span>.
      </p>
    </div>

    <!-- Social Links -->
    <div class="flex items-center gap-2 mb-14">
      <a
        href="https://instagram.com"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Instagram"
        class="flex size-8 items-center justify-center rounded-md text-[#666] transition-colors duration-150 hover:text-accent"
      >
        <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2c2.72 0 3.06.01 4.12.06 1.07.05 1.8.22 2.43.47.66.25 1.22.6 1.77 1.15.55.55.9 1.11 1.15 1.77.25.63.42 1.36.47 2.43.05 1.06.06 1.4.06 4.12s-.01 3.06-.06 4.12c-.05 1.07-.22 1.8-.47 2.43a4.9 4.9 0 0 1-1.15 1.77c-.55.55-1.11.9-1.77 1.15-.63.25-1.36.42-2.43.47-1.06.05-1.4.06-4.12.06s-3.06-.01-4.12-.06c-1.07-.05-1.8-.22-2.43-.47a4.9 4.9 0 0 1-1.77-1.15 4.9 4.9 0 0 1-1.15-1.77c-.25-.63-.42-1.36-.47-2.43C2.01 15.06 2 14.72 2 12s.01-3.06.06-4.12c.05-1.07.22-1.8.47-2.43.25-.66.6-1.22 1.15-1.77.55-.55 1.11-.9 1.77-1.15.63-.25 1.36-.42 2.43-.47C8.94 2.01 9.28 2 12 2zm0 1.8c-2.67 0-2.99.01-4.04.06-.98.04-1.51.21-1.86.35-.47.18-.8.4-1.15.75-.35.35-.57.68-.75 1.15-.14.35-.31.88-.35 1.86-.05 1.05-.06 1.37-.06 4.04s.01 2.99.06 4.04c.04.98.21 1.51.35 1.86.18.47.4.8.75 1.15.35.35.68.57 1.15.75.35.14.88.31 1.86.35 1.05.05 1.37.06 4.04.06s2.99-.01 4.04-.06c.98-.04 1.51-.21 1.86-.35.47-.18.8-.4 1.15-.75.35-.35.57-.68.75-1.15.14-.35.31-.88.35-1.86.05-1.05.06-1.37.06-4.04s-.01-2.99-.06-4.04c-.04-.98-.21-1.51-.35-1.86a3.1 3.1 0 0 0-.75-1.15 3.1 3.1 0 0 0-1.15-.75c-.35-.14-.88-.31-1.86-.35-1.05-.05-1.37-.06-4.04-.06zm0 3.07a5.13 5.13 0 1 1 0 10.26 5.13 5.13 0 0 1 0-10.26zm0 1.8a3.33 3.33 0 1 0 0 6.66 3.33 3.33 0 0 0 0-6.66zm5.34-3.2a1.2 1.2 0 1 1 0 2.4 1.2 1.2 0 0 1 0-2.4z"></path></svg>
      </a>
      <a
        href="https://github.com/Panth1823"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
        class="flex size-8 items-center justify-center rounded-md text-[#666] transition-colors duration-150 hover:text-accent"
      >
        <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.49 0-.24-.01-.87-.01-1.71-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.5-1.11-1.5-.91-.63.07-.62.07-.62 1 .07 1.53 1.05 1.53 1.05.89 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.37-2.22-.26-4.56-1.14-4.56-5.05 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05a9.3 9.3 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.92-2.34 4.79-4.57 5.04.36.32.68.94.68 1.9 0 1.37-.01 2.48-.01 2.82 0 .27.18.6.69.49A10.02 10.02 0 0 0 22 12.25C22 6.58 17.52 2 12 2z"></path></svg>
      </a>
      <a
        href="https://linkedin.com/in/panthpatel18"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn"
        class="flex size-8 items-center justify-center rounded-md text-[#666] transition-colors duration-150 hover:text-accent"
      >
        <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"></path></svg>
      </a>
      <a
        href="mailto:panthpatel18@example.com"
        aria-label="Email"
        class="flex size-8 items-center justify-center rounded-md text-[#666] transition-colors duration-150 hover:text-accent"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="size-5">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
          <polyline points="22,6 12,13 2,6"></polyline>
        </svg>
      </a>
    </div>

    <!-- Experience -->
    <section class="mb-12">
      <h2 class="text-sm font-medium text-[#a6a09b] mb-6">
        Experience
      </h2>

      <div class="space-y-8">
        {
          experience.map((job) => (
            <div class="flex gap-4">
              <!-- Company icon bubble -->
              <div class="flex size-9 shrink-0 items-center justify-center rounded-[10px] bg-[#292526] text-foreground mt-0.5">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                  <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                </svg>
              </div>

              <div class="flex-1 min-w-0">
                <!-- Company -->
                <div class="flex items-center gap-2 mb-1">
                  <span class="text-[16px] font-semibold text-white">{job.company}</span>
                </div>
                <p class="text-sm text-[#a6a09b] mb-3">{job.location}</p>

                <!-- Roles accordion -->
                <div class="space-y-0">
                  {job.roles.map((role, roleIndex) => {
                    const roleId = `role-${job.company.replace(/\s+/g, '-').toLowerCase()}-${roleIndex}`;
                    return (
                      <div class="border-l border-white/[0.07]">
                        <!-- Role header (clickable) -->
                        <button
                          type="button"
                          class={`role-toggle w-full flex items-start justify-between gap-4 py-2 pl-3 text-left cursor-pointer`}
                          aria-expanded="false"
                          data-target={roleId}
                        >
                          <div class="flex items-start gap-2 min-w-0">
                            <!-- Role type icon -->
                            {role.icon === "briefcase" && (
                              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={`mt-0.75 shrink-0 ${role.active ? "text-accent" : "text-[#3a3a3a]"}`}>
                                <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                                <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                              </svg>
                            )}
                            {role.icon === "code" && (
                              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={`mt-0.75 shrink-0 ${role.active ? "text-accent" : "text-[#3a3a3a]"}`}>
                                <polyline points="16 18 22 12 16 6"></polyline>
                                <polyline points="8 6 2 12 8 18"></polyline>
                              </svg>
                            )}
                            {role.icon === "users" && (
                              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={`mt-0.75 shrink-0 ${role.active ? "text-accent" : "text-[#3a3a3a]"}`}>
                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                <circle cx="9" cy="7" r="4"></circle>
                                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                              </svg>
                            )}
                            {role.icon === "git" && (
                              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={`mt-0.75 shrink-0 ${role.active ? "text-accent" : "text-[#3a3a3a]"}`}>
                                <circle cx="18" cy="18" r="3"></circle>
                                <circle cx="6" cy="6" r="3"></circle>
                                <path d="M13 6h3a2 2 0 0 1 2 2v7"></path>
                                <line x1="6" y1="9" x2="6" y2="21"></line>
                              </svg>
                            )}
                            <div class="min-w-0">
                              <p class={`text-[0.82rem] font-medium leading-snug ${role.active ? "text-accent" : "text-[#bbb]"}`}>
                                {role.title}
                              </p>
                              <p class={`text-[0.72rem] mt-0.5 ${role.active ? "text-accent/60" : "text-[#444]"}`}>
                                {role.type} · {role.period}
                              </p>
                            </div>
                          </div>
                          <!-- Chevron -->
                          <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="14"
                            height="14"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="chevron shrink-0 mt-0.5 text-[#444] transition-transform duration-200"
                          >
                            <polyline points="6 9 12 15 18 9"></polyline>
                          </svg>
                        </button>

                        <!-- Collapsible description -->
                        <div id={roleId} class="role-content hidden overflow-hidden pl-5.75 pb-2">
                          <p class="text-[0.78rem] text-[#555] leading-relaxed">
                            {role.description}
                          </p>
                        </div>
                      </div>
                    );
                  })}
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Education -->
    <section>
      <h2 class="text-sm font-medium text-[#a6a09b] mb-5">
        Education
      </h2>

      <div class="space-y-3">
        {
          education.map((edu) => (
            <div class="flex items-baseline gap-5">
              <span class="text-[0.75rem] text-[#444] shrink-0 w-16">{edu.period}</span>
              <div>
                <span class="text-sm font-semibold text-white">{edu.degree}</span>
                <span class="text-sm text-[#555]">, {edu.institution}.</span>
              </div>
            </div>
          ))
        }
      </div>
    </section>

  </div>
</Layout>

<script>
  function initAccordion() {
    const toggles = document.querySelectorAll<HTMLButtonElement>(".role-toggle");

    toggles.forEach((btn) => {
      // Remove any previous listener by cloning
      const fresh = btn.cloneNode(true) as HTMLButtonElement;
      btn.parentNode?.replaceChild(fresh, btn);

      fresh.addEventListener("click", () => {
        const targetId = fresh.dataset.target!;
        const content = document.getElementById(targetId);
        const chevron = fresh.querySelector<SVGElement>(".chevron");
        const isOpen = fresh.getAttribute("aria-expanded") === "true";

        if (isOpen) {
          content?.classList.add("hidden");
          chevron?.classList.remove("rotate-180");
          fresh.setAttribute("aria-expanded", "false");
        } else {
          content?.classList.remove("hidden");
          chevron?.classList.add("rotate-180");
          fresh.setAttribute("aria-expanded", "true");
        }
      });
    });
  }

  initAccordion();
  document.addEventListener("astro:after-swap", initAccordion);
</script>
