---
import Layout from "../layouts/Layout.astro";

const caseStudies = [
  {
    title: "formulaCoach",
    description:
      "An AI-powered F1 telemetry analysis platform — real-time data visualisations, lap comparisons, and race strategy insights powered by LLMs.",
    date: "In progress",
    href: "https://github.com/Panth1823",
    links: [{ label: "GitHub", href: "https://github.com/Panth1823" }],
  },
  {
    title: "GenAI Exchange",
    description:
      "A hackathon platform powered by Google's Generative AI — connecting developers, mentors, and sponsors across India. Built end-to-end for the GDG hackathon ecosystem.",
    date: "Nov 2024",
    href: "https://github.com/Panth1823",
    links: [{ label: "GitHub", href: "https://github.com/Panth1823" }],
  },
  {
    title: "PLH — Parul Let's Hack",
    description:
      "Full-stack hackathon management platform built for Parul University handling registrations, teams, judging, and live result broadcasting for 2000+ participants.",
    date: "Mar 2024",
    href: "https://github.com/Panth1823",
    links: [{ label: "GitHub", href: "https://github.com/Panth1823" }],
  },
  {
    title: "Skillathon",
    description:
      "An NSDC-backed skilling & education hackathon platform with real-time leaderboards, OBC support, and team management. Used across multiple national events.",
    date: "Jan 2024",
    href: "https://github.com/Panth1823",
    links: [{ label: "GitHub", href: "https://github.com/Panth1823" }],
  },
];

const tools = [
  {
    title: "formulaCoach CLI",
    description:
      "Command-line tool to pull and diff F1 session telemetry directly from the FastF1 API.",
    tags: ["python", "cli", "f1"],
    href: "https://github.com/Panth1823",
  },
  {
    title: "AI Prompt Kit",
    description:
      "A curated collection of prompts and LLM utilities for developer workflows — generation, review, and refactor.",
    tags: ["ai", "llm", "tools"],
    href: "https://github.com/Panth1823",
  },
];
---

<Layout
  title="Work — Panth"
  description="Case studies and open-source tools built by Panth."
>
  <div class="pb-20">
    <!-- Breadcrumb -->
    <nav
      class="flex items-center gap-2 text-[0.72rem] font-medium tracking-widest uppercase mb-14"
    >
      <a
        href="/"
        class="inline-flex items-center gap-1.5 text-[#a6a09b] hover:text-accent transition-colors duration-150 text-[12px]"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="1em"
          height="1em"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-3.5"
          aria-hidden="true"
        >
          <path d="M20 12H4m0 0l6-6m-6 6l6 6"></path>
        </svg>
        Back to home
      </a>
      <span class="text-[#333]">/</span>
      <span class="text-accent text-[12px]">Work</span>
    </nav>

    <!-- Page heading -->
    <div class="mb-12">
      <h1 class="text-3xl font-bold tracking-tight text-white mb-2">Work</h1>
      <p
        class="mt-4 max-w-136 leading-relaxed text-muted-foreground text-md"
      >
        Projects I've shipped, plus the open-source tools I build on the side.
      </p>
    </div>

    <!-- Case Studies -->
    <section class="mb-14">
      <p class="text-base font-medium text-accent tracking-[0.02em] mb-5">
        Case studies
      </p>

      <div class="flex flex-col divide-y divide-white/6">
        {
          caseStudies.map((project) => (
            <a
              href={project.href}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-start justify-between gap-6 py-4 hover:opacity-80 transition-opacity duration-150"
            >
              <div class="flex-1 min-w-0">
                <h2 class="text-[0.95rem] font-semibold text-white leading-snug mb-1 group-hover:text-accent transition-colors duration-150">
                  {project.title}
                </h2>
                <p class="text-[0.82rem] text-[#999] leading-[1.6]">
                  {project.description}
                </p>
              </div>
              <span class="shrink-0 text-[0.75rem] text-[#666] pt-0.5">
                {project.date}
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <!-- Tools -->
    <section>
      <p class="text-base font-medium text-accent tracking-[0.02em] mb-5">
        Tools
      </p>

      <div class="flex flex-col divide-y divide-white/6">
        {
          tools.map((tool) => (
            <div class="py-4">
              <div class="flex items-start gap-1.5 mb-1.5">
                <h2 class="text-[0.95rem] font-semibold text-white leading-snug mb-0">
                  <a
                    href={tool.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hover:text-accent transition-colors duration-150 inline-flex items-center gap-1"
                  >
                    {tool.title}
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="11"
                      height="11"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="opacity-50"
                    >
                      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                      <polyline points="15 3 21 3 21 9" />
                      <line x1="10" y1="14" x2="21" y2="3" />
                    </svg>
                  </a>
                </h2>
              </div>
              <p class="text-[0.82rem] text-[#999] leading-[1.6] mb-2.5">
                {tool.description}
              </p>
              <div class="flex flex-wrap gap-1.5">
                {tool.tags.map((tag) => (
                  <span class="px-2 py-0.5 rounded-full text-[0.68rem] font-medium bg-white/4 border border-white/[0.07] text-[#666]">
                    #{tag}
                  </span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </section>
  </div>
</Layout>
